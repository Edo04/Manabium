# このファイルを .dev.vars にコピーし、実際の値へ置き換えます。
# .dev.vars はGitにコミットしないでください。

SUPABASE_URL="https://xtzwpybdcvokamrhpbtc.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_Vo6HQLzhxN_4Vd2pSM0KZQ_8uZVXwaU"

# Azure OpenAIリソースのルートURL。末尾の /openai/v1 はあってもなくても動作します。
AZURE_OPENAI_ENDPOINT="https://YOUR-RESOURCE-NAME.openai.azure.com"
AZURE_OPENAI_API_KEY="YOUR-AZURE-OPENAI-KEY"
# Azure上で作成した「モデルのデプロイ名」。モデル名そのものではありません。
AZURE_OPENAI_DEPLOYMENT="YOUR-DEPLOYMENT-NAME"

# Azure AI Languageリソースの「Keys and Endpoint」に表示される値です。
AZURE_LANGUAGE_ENDPOINT="https://YOUR-LANGUAGE-RESOURCE.cognitiveservices.azure.com"
AZURE_LANGUAGE_KEY="YOUR-AZURE-LANGUAGE-KEY"
